# Required only when planner.mode=openai
OPENAI_API_KEY=

# Exact model used in experiments. Keep fixed across the final experimental run.
OPENAI_MODEL=gpt-5.6-luna

# Optional pricing snapshot for reproducible cost estimates.
# Values below are USD per 1M tokens. Update only if you change the model/pricing date.
OPENAI_INPUT_COST_PER_MTOK=0.20
OPENAI_OUTPUT_COST_PER_MTOK=1.20
